{
  "rewrites": [
    {
      "source": "/baixar",
      "destination": "/"
    },
    {
      "source": "/baixar/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
