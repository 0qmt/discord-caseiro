{
  "name": "discord-caseiro-desktop",
  "version": "0.2.41",
  "private": true,
  "description": "Cliente de desktop do discordia",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --publish=never",
    "publicar": "node scripts/publicar.js",
    "smoke": "electron scripts/smoke-electron.js",
    "smoke:fullscreen": "electron scripts/smoke-fullscreen-kiosk.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.discordcaseiro.app",
    "productName": "discordia",
    "icon": "build/icon.png",
    "files": [
      "src/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "0qmt",
      "repo": "discord-caseiro"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "discordia"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    }
  }
}
