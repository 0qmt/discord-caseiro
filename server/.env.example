# Porta do backend (API + WebSocket)
PORT=3001

# Origens permitidas no CORS durante o desenvolvimento (cliente Vite)
CLIENT_ORIGIN=http://localhost:5173

# Segredo dos tokens JWT.
# Se ficar vazio, o servidor gera um automaticamente em data/.jwt-secret
JWT_SECRET=

# Caminho do banco SQLite (relativo a server/)
DB_PATH=../data/app.db

# Permitir cadastro de novas contas (deixe true enquanto testa local;
# vire false depois que todo mundo tiver conta, na etapa de exposicao)
ALLOW_REGISTRATION=true

# Chave da API do Giphy, pra busca de GIF no chat (developers.giphy.com,
# cadastro gratis, sem cartao). Sem isso o botao de GIF so nao aparece.
GIPHY_API_KEY=
